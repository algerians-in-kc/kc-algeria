# Email (Resend) — optional, contact + intake forms fall back to console.log without these
RESEND_API_KEY=your_resend_api_key
CONTACT_EMAIL=your@email.com

# Where volunteer/newcomer form notifications are sent (falls back to CONTACT_EMAIL)
COORDINATOR_EMAIL=coordinators@email.com

# Airtable — volunteer/newcomer submissions are saved here for coordinators to manage.
# Without these, forms still work and just email the coordinators.
# API key: a personal access token from https://airtable.com/create/tokens
# Base ID: from https://airtable.com/api (looks like appXXXXXXXXXXXXXX)
AIRTABLE_API_KEY=your_airtable_personal_access_token
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Google Analytics — get from analytics.google.com (format: G-XXXXXXXXXX)
PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
